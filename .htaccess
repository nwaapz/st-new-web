# StarTech static export + PHP CMS (site root = this folder, e.g. htdocs/test2)

# Ensure web fonts load correctly under Apache/XAMPP
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/font-woff2 .woff2
  AddType application/font-woff .woff
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|woff|ttf|otf)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # If a product slug folder was not prebuilt, serve the `_` shell HTML.
  # The client reads the real slug from the browser URL.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html !-f
  RewriteRule ^products/([^/]+)/?$ products/_/index.html [L]

  # Same pattern for profile order detail pages.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html !-f
  RewriteRule ^profile/orders/([^/]+)/?$ profile/orders/_/index.html [L]

  # Mechanic CRM (Customer Club) customer/vehicle detail pages.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html !-f
  RewriteRule ^customerclub/customers/([^/]+)/?$ customerclub/customers/_/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html !-f
  RewriteRule ^customerclub/vehicles/([^/]+)/?$ customerclub/vehicles/_/index.html [L]

  # Public invoice PDF stream (SMS landing page is the Next shop shell below).
  RewriteCond %{QUERY_STRING} (?:^|&)download=
  RewriteRule ^i/([a-fA-F0-9]{32})/?$ invoice.php?t=$1 [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html !-f
  RewriteRule ^i/([a-fA-F0-9]{32})/?$ i/_/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html !-f
  RewriteRule ^k/([a-fA-F0-9]{32})/?$ k/_/index.html [L]
</IfModule>
